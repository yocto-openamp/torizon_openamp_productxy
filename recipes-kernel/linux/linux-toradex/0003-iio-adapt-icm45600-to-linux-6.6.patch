 #include <linux/types.h>
 
-#include <linux/iio/common/inv_sensors_timestamp.h>
+#include "inv_icm45600_timestamp.h"
 #include <linux/iio/iio.h>
 
 #include "inv_icm45600_buffer.h"
@@ -181,7 +181,7 @@ struct inv_icm45600_sensor_state {
 	const int *scales;
 	size_t scales_len;
 	enum inv_icm45600_sensor_mode power_mode;
-	struct inv_sensors_timestamp ts;
+	struct inv_icm45600_timestamp ts;
 };
 
 /* Virtual register addresses: @bank on MSB (16 bits), @address on LSB */
