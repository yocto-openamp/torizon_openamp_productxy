Subject: [PATCH] iio: adapt ICM-45600 to Linux 6.6 interfaces

Use the 6.6 direct-mode and buffer APIs and symbol namespace syntax.
Keep a private copy of the v6.19 InvenSense timestamp helper because the
6.6 shared helper has a different API and algorithm; changing the shared
helper would affect existing IIO drivers.

Upstream-Status: Inappropriate [6.6-specific backport]

diff --git a/drivers/iio/imu/inv_icm45600/Kconfig b/drivers/iio/imu/inv_icm45600/Kconfig
index dc13340..a93d70f 100644
--- a/drivers/iio/imu/inv_icm45600/Kconfig
+++ b/drivers/iio/imu/inv_icm45600/Kconfig
@@ -4,7 +4,6 @@ config INV_ICM45600
 	tristate
 	select IIO_BUFFER
 	select IIO_KFIFO_BUF
-	select IIO_INV_SENSORS_TIMESTAMP
 
 config INV_ICM45600_I2C
 	tristate "InvenSense ICM-456xx I2C driver"
diff --git a/drivers/iio/imu/inv_icm45600/Makefile b/drivers/iio/imu/inv_icm45600/Makefile
index c98b836..416ac1d 100644
--- a/drivers/iio/imu/inv_icm45600/Makefile
+++ b/drivers/iio/imu/inv_icm45600/Makefile
@@ -5,6 +5,7 @@ inv-icm45600-y += inv_icm45600_core.o
 inv-icm45600-y += inv_icm45600_buffer.o
 inv-icm45600-y += inv_icm45600_gyro.o
 inv-icm45600-y += inv_icm45600_accel.o
+inv-icm45600-y += inv_icm45600_timestamp.o
 
 obj-$(CONFIG_INV_ICM45600_I2C) += inv-icm45600-i2c.o
 inv-icm45600-i2c-y += inv_icm45600_i2c.o
diff --git a/drivers/iio/imu/inv_icm45600/inv_icm45600.h b/drivers/iio/imu/inv_icm45600/inv_icm45600.h
