 	if (ret)
 		return ret;
@@ -545,10 +545,10 @@ static int inv_icm45600_accel_read_raw(struct iio_dev *indio_dev,
 
 	switch (mask) {
 	case IIO_CHAN_INFO_RAW:
-		if (!iio_device_claim_direct(indio_dev))
