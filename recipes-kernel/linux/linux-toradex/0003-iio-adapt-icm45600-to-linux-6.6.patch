 	iio_device_set_drvdata(indio_dev, st);
 	indio_dev->name = name;
@@ -743,7 +743,7 @@ int inv_icm45600_accel_parse_fifo(struct iio_dev *indio_dev)
 {
 	struct inv_icm45600_state *st = iio_device_get_drvdata(indio_dev);
 	struct inv_icm45600_sensor_state *accel_st = iio_priv(indio_dev);
-	struct inv_sensors_timestamp *ts = &accel_st->ts;
+	struct inv_icm45600_timestamp *ts = &accel_st->ts;
 	ssize_t i, size;
 	unsigned int no;
 
@@ -768,14 +768,18 @@ int inv_icm45600_accel_parse_fifo(struct iio_dev *indio_dev)
 
 		/* update odr */
 		if (odr & INV_ICM45600_SENSOR_ACCEL)
-			inv_sensors_timestamp_apply_odr(ts, st->fifo.period,
+			inv_icm45600_timestamp_apply_odr(ts, st->fifo.period,
 							 st->fifo.nb.total, no);
 
 		memcpy(&buffer.accel, accel, sizeof(buffer.accel));
 		/* convert 8 bits FIFO temperature in high resolution format */
 		buffer.temp = temp ? (*temp * 64) : 0;
-		ts_val = inv_sensors_timestamp_pop(ts);
-		iio_push_to_buffers_with_ts(indio_dev, &buffer, sizeof(buffer), ts_val);
+		ts_val = inv_icm45600_timestamp_pop(ts);
+		if (unlikely(sizeof(buffer) < indio_dev->scan_bytes)) {
+			dev_err(&indio_dev->dev, "Undersized storage pushed to buffer\n");
+			return -ENOSPC;
+		}
+		iio_push_to_buffers_with_timestamp(indio_dev, &buffer, ts_val);
 	}
 
 	return 0;
