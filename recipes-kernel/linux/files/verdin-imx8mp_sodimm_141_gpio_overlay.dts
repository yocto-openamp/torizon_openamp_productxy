/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "toradex,verdin-imx8mp";
};

/* Use SODIMM 141 as GPIO */
&gpio2 {
	status = "okay";
	sodimm_141 {
		gpio-hog;
		gpios = <7 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "sodimm_141";
	};
};
