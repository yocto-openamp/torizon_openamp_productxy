/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include "imx8mp-pinfunc.h"

/ {
	compatible = "toradex,verdin-imx8mp";
};

/ {
	fragment@0 {
		target = <&iomuxc>;
		__overlay__ {
			sodimm_141_gpio_pins {
				fsl,pins = <MX8MP_IOMUXC_SD1_DATA5__GPIO2_IO07>;
			};
		};
	};

	fragment@1 {
		target = <&gpio2>;
		__overlay__ {
			status = "okay";
		};
	};
};
